# =============================================================================
# notAEC Environment Configuration
# Copy this file to .env and fill in secure values before running.
# NEVER commit .env to version control.
# =============================================================================

# --- Flask ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# This Compose stack is an HTTP-only local demo. Production must use
# DEPLOYMENT_ENV=production, HTTPS, and SESSION_COOKIE_SECURE=true.
DEPLOYMENT_ENV=local-demo
SESSION_COOKIE_SECURE=false
# Canonical origin used in verification and reset emails. Production requires
# HTTPS. Requests with any Host outside TRUSTED_HOSTS are rejected.
PUBLIC_BASE_URL=http://localhost
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Database (Docker Compose) ---
# Generate unique values of at least 16 characters for every database password.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=votingdb
MYSQL_USER=votinguser
MYSQL_PASSWORD=
VOTING_ADMIN_USER=voting_admin
VOTING_ADMIN_PASS=
VOTING_VOTER_USER=voting_voter
VOTING_VOTER_PASS=

# --- One-time manager bootstrap (used only by db-init) ---
# Remove or rotate BOOTSTRAP_MANAGER_PASSWORD after the first successful login.
# Generate a unique password and use a real administrator identity reference.
BOOTSTRAP_MANAGER_USERNAME=securevote_admin
BOOTSTRAP_MANAGER_EMAIL=admin@example.invalid
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_LICENSE=
BOOTSTRAP_MANAGER_LICENSE_STATE=VIC

# --- Encryption ---
# 32-byte key, Base64 encoded. Generate:
# python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
VOTER_PII_KEY_BASE64=

# --- Blind Index Pepper (for driver licence hash) ---
# High-entropy secret mixed into deterministic hashes. Generate:
# python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_HASH_PEPPER=

# --- Geo-Filtering ---
GEO_FILTER_ENABLED=True
ALLOWED_COUNTRIES=AU

# --- MFA ---
ENABLE_MFA=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# --- Audit Log ---
# HMAC key for tamper-evident audit log chain. Generate:
# python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=

# --- Vault (optional) ---
VAULT_ADDR=http://vault:8200
# Compose uses this only inside the dev Vault and one-shot initializer. The web
# service receives a generated scoped token through a read-only volume.
# Generate a unique random value of at least 16 characters.
VAULT_DEV_ROOT_TOKEN=
# For an external Vault outside Compose, set VAULT_TOKEN or VAULT_TOKEN_FILE.
VAULT_TOKEN=
VAULT_TOKEN_FILE=
VAULT_CLUSTER_ID=securevote-dev
VAULT_NAMESPACE=
VAULT_MOUNT=transit
VAULT_KV_MOUNT=kv
VAULT_TRANSIT_KEY=results-signing

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_DB_BIND=false
